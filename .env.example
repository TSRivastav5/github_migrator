# GitHub Migrator — Environment Configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
#
# ── Source repository (the one you are migrating FROM) ─────────────────────
SOURCE_TOKEN=ghp_your_source_personal_access_token_here
SOURCE_REPO=owner/repo-name          # e.g. acme-corp/backend-api

# ── Destination (the GitHub account/org you are migrating TO) ───────────────
DEST_TOKEN=ghp_your_destination_personal_access_token_here
DEST_OWNER=your-dest-github-username-or-org
DEST_REPO=new-repo-name              # name for the newly created repo

# ── Options ────────────────────────────────────────────────────────────────
DEST_PRIVATE=true                    # true = private repo, false = public

# ── Required token scopes ─────────────────────────────────────────────────
# SOURCE_TOKEN: repo, read:org
# DEST_TOKEN  : repo, workflow
